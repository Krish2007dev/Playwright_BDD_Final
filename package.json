{
  "name": "playwright-bdd-framework",
  "version": "2.0.0",
  "description": "🚀 A comprehensive, beginner-friendly BDD automation framework built with Playwright, Cucumber, and TypeScript. Supports UI + API testing with rich reporting.",
  "main": "index.js",
  "scripts": {
    "test": "npx bddgen && npx playwright test",
    "test:ui": "npx bddgen && npx playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "npx bddgen && npx playwright test --project=api",
    "test:chrome": "npx bddgen && npx playwright test --project=chromium",
    "test:firefox": "npx bddgen && npx playwright test --project=firefox",
    "test:webkit": "npx bddgen && npx playwright test --project=webkit",
    "test:smoke": "npx bddgen && npx playwright test --grep @smoke",
    "test:a11y": "npx bddgen && npx playwright test --grep @a11y --project=chromium",
    "test:regression": "npx bddgen && npx playwright test --grep @regression",
    "test:headed": "npx bddgen && npx playwright test --headed --project=chromium",
    "test:debug": "npx bddgen && npx playwright test --debug --project=chromium",
    "test:interactive": "npx bddgen && npx playwright test --ui",
    "report": "npx playwright show-report",
    "report:cucumber": "node scripts/open-report.mjs cucumber-report.html",
    "report:allure": "npx allure serve allure-results",
    "report:dashboard": "node scripts/open-report.mjs test-results/reports/dashboard.html",
    "report:monocart": "node scripts/open-report.mjs test-results/monocart/report.html",
    "report:all": "node scripts/open-report.mjs playwright-report/index.html test-results/reports/dashboard.html test-results/monocart/report.html && npx allure generate -o allure-report --name 'PlaywrightBDD Report' --open",
    "test:report": "npm run clean && npm test && npm run report:all",
    "clean": "node scripts/clean.mjs",
    "clean:all": "npm run clean && node scripts/clean-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "validate": "npm run typecheck && npm run format:check",
    "setup": "npm install && node scripts/install-browsers.mjs",
    "setup:env": "node scripts/init-env.mjs"
  },
  "keywords": [
    "playwright",
    "bdd",
    "cucumber",
    "automation",
    "testing",
    "typescript",
    "e2e",
    "api-testing"
  ],
  "author": "PlaywrightBDD Team",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@playwright/test": "1.58",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-playwright": "^3.4.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "monocart-reporter": "^2.10.0",
    "playwright": "1.58",
    "playwright-bdd": "^8.5.1",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "genson-js": "^0.0.8",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6"
  }
}
